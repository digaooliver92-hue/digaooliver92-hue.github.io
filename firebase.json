{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "**/*.sh", "**/*.txt", "**/*.log", "**/*.md"],
    "headers": [
      { "source": "**/*.@(png|jpg|jpeg|webp|svg|mp4|mp3)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
